# Example environment for scripts/start_t2i_service.sh
# Copy to your shell profile or export before starting the service.

# Model path on your GPU server
export T2I_MODEL_PATH="/nas/models/t2i/qwen-image-2512/Qwen/Qwen-Image-2512"

# Two physical GPUs exposed to this single model instance (device_map=balanced)
export T2I_CUDA_DEVICES="0,1"

# HTTP bind
export T2I_HOST="0.0.0.0"
export T2I_PORT="8100"

# Queue / timeout
export T2I_MAX_QUEUE_SIZE="32"
export T2I_REQUEST_TIMEOUT_SECONDS="600"

# Defaults used when request omits size/steps/cfg
export T2I_DEFAULT_WIDTH="1664"
export T2I_DEFAULT_HEIGHT="928"
export T2I_DEFAULT_STEPS="50"
export T2I_DEFAULT_CFG_SCALE="4.0"

# Logging
export T2I_LOG_DIR="./logs/t2i_service"
export T2I_LOG_LEVEL="INFO"
