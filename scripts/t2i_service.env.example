# Example environment for scripts/start_t2i_service.sh
# Copy to your shell profile or export before starting the service.

# Qwen-Image-Edit model path on your GPU server
export T2I_MODEL_PATH="/nas/models/i2i/qwen/Qwen/Qwen-Image-Edit-2511"

# Two physical GPUs for one model instance (device_map=balanced)
# Single GPU example:
#   export T2I_CUDA_DEVICES="1"
#   export T2I_DEVICE_MAP="cuda"
export T2I_CUDA_DEVICES="0,1"
export T2I_DEVICE_MAP="balanced"

# HTTP bind
export T2I_HOST="0.0.0.0"
export T2I_PORT="8100"

# Queue / timeout
export T2I_MAX_QUEUE_SIZE="32"
export T2I_MAX_REFERENCE_IMAGES="8"
export T2I_REQUEST_TIMEOUT_SECONDS="600"

# Require at least one reference image. Set false to allow blank canvas fallback.
export T2I_REQUIRE_REFERENCE_IMAGES="false"

# Defaults used when request omits values
export T2I_DEFAULT_WIDTH="1664"
export T2I_DEFAULT_HEIGHT="928"
export T2I_DEFAULT_STEPS="40"
export T2I_DEFAULT_CFG_SCALE="4.0"
export T2I_DEFAULT_GUIDANCE_SCALE="1.0"
export T2I_DEFAULT_NEGATIVE_PROMPT=" "

# Job memory retention (async polling keeps last N finished jobs in RAM)
export T2I_JOB_RETENTION_COUNT="64"

# Logging
export T2I_LOG_DIR="./logs/t2i_service"
export T2I_LOG_LEVEL="INFO"
